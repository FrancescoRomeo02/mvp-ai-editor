{
  "name": "tiptap-block-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-dev-vars.mjs next dev",
    "build": "node scripts/with-dev-vars.mjs next build",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:build": "node scripts/with-dev-vars.mjs opennextjs-cloudflare build",
    "secrets:sync": "node scripts/sync-cloudflare-secrets.mjs",
    "preview": "npm run cf:build && opennextjs-cloudflare preview",
    "deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@pydantic/logfire-cf-workers": "^2.0.11",
    "@pydantic/logfire-node": "^0.18.15",
    "@supabase/supabase-js": "^2.112.3",
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-blockquote": "^2.27.2",
    "@tiptap/extension-bullet-list": "^2.27.2",
    "@tiptap/extension-code-block": "^2.27.2",
    "@tiptap/extension-document": "^2.11.5",
    "@tiptap/extension-heading": "^2.27.2",
    "@tiptap/extension-horizontal-rule": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-list-item": "^2.27.2",
    "@tiptap/extension-mathematics": "^2.27.2",
    "@tiptap/extension-mention": "^2.27.2",
    "@tiptap/extension-ordered-list": "^2.27.2",
    "@tiptap/extension-paragraph": "^2.11.5",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text": "^2.11.5",
    "@tiptap/extension-youtube": "^2.27.2",
    "@tiptap/react": "^2.11.5",
    "katex": "^0.16.22",
    "logfire": "^0.21.10",
    "next": "^16.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260819.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "26.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
